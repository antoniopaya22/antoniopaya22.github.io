---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import { createHash } from 'node:crypto';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
  /** keep utility pages (404) out of the index */
  noindex?: boolean;
}

const { title, description = 'Antonio Payá González — Software Architect, Professor at UNIR and PhD in Computer Science specializing in cybersecurity, Zero Trust, cloud architecture and AI.', lang = 'es', ogImage = '/images/og-card.png', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = 'https://antoniopaya22.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const altLang = lang === 'es' ? 'en' : 'es';
const altUrl = lang === 'es' ? `${siteUrl}/en/` : `${siteUrl}/`;
const isHome = canonicalUrl === `${siteUrl}/` || canonicalUrl === `${siteUrl}/en/`;
const ogAlt = lang === 'es'
  ? 'Antonio Payá González — Arquitecto de Software, Profesor en UNIR y PhD'
  : 'Antonio Payá González — Software Architect, Professor at UNIR & PhD';
const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const photoId = `${siteUrl}/#photo`;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const skip = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';

// the only inline script (theme before first paint); its hash is pinned in the CSP
const themeScript = `(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')d.setAttribute('data-theme',t);}catch(e){}})();`;
const themeHash = createHash('sha256').update(themeScript).digest('base64');
const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${themeHash}'`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');

const person = {
  "@type": "Person",
  "@id": personId,
  "name": "Antonio Payá González",
  "url": siteUrl,
  "image": {
    "@type": "ImageObject",
    "@id": photoId,
    "url": `${siteUrl}/images/antonio-paya-gonzalez.jpg`,
    "contentUrl": `${siteUrl}/images/antonio-paya-gonzalez.jpg`,
    "width": 686,
    "height": 911,
    "caption": ogAlt,
    "creditText": "Antonio Payá González"
  },
  "description": "Software Architect at TheNextPangea, Professor at the International University of La Rioja (UNIR) and PhD in Computer Science. Specialist in cloud architecture, AI productization, cybersecurity, and Zero Trust security.",
  "jobTitle": ["Software Architect", "Professor"],
  "worksFor": [
    {
      "@type": "Organization",
      "name": "TheNextPangea S.L.",
      "url": "https://thenextpangea.com/"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "UNIR - Universidad Internacional de La Rioja",
      "url": "https://www.unir.net/"
    }
  ],
  "affiliation": {
    "@type": "CollegeOrUniversity",
    "name": "UNIR - Universidad Internacional de La Rioja",
    "url": "https://www.unir.net/"
  },
  "hasOccupation": [
    {
      "@type": "Occupation",
      "name": "Software Architect"
    },
    {
      "@type": "Occupation",
      "name": "University Professor",
      "description": "Professor in the Bachelor's Degree in Cybersecurity, the Master's Degree in Cybersecurity and the Master's Degree in Digital Transformation through Disruptive Technologies at UNIR."
    }
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Universidad de Oviedo"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Gijón",
    "addressRegion": "Asturias",
    "addressCountry": "ES"
  },
  "knowsAbout": ["Software Architecture", "Cybersecurity", "Zero Trust", "Software-Defined Perimeter", "Intrusion Detection Systems", "Adversarial Machine Learning", "Cloud Computing", "Terraform", "AI/ML Productization", "Digital Transformation"],
  "sameAs": [
    "https://github.com/antoniopaya22",
    "https://www.linkedin.com/in/antoniopaya22/",
    "https://scholar.google.com/citations?user=4bCBOysAAAAJ",
    "https://orcid.org/0000-0003-3733-3805",
    "https://www.researchgate.net/profile/Antonio-Paya-3",
    "https://medium.com/@antonioalfa22",
    "https://www.wikidata.org/wiki/Q141724486"
  ],
  "alternateName": ["Antonio Payá", "Antonio Paya Gonzalez", "A. Payá González"]
};

// one connected graph: WebSite → ProfilePage → Person (the entity the page is about)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": `${siteUrl}/`,
      "name": "Antonio Payá González",
      "alternateName": ["Antonio Payá", "Antonio Paya"],
      "inLanguage": ["es", "en"],
      "publisher": { "@id": personId }
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#profile`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": lang,
      "isPartOf": { "@id": websiteId },
      "about": { "@id": personId },
      "mainEntity": { "@id": personId },
      "primaryImageOfPage": { "@id": photoId },
      "dateModified": new Date().toISOString()
    },
    person
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Antonio Payá González" />
    <meta name="keywords" content="Antonio Payá González, Antonio Payá, Antonio Paya Gonzalez, software architect, profesor UNIR, professor UNIR, PhD computer engineering, cybersecurity, ciberseguridad, zero trust, software-defined perimeter, artificial intelligence, Universidad de Oviedo, Gijón" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#07090C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F6F2" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="UQinHbKmnToC-3fal-2WekX6NkpLHj5RfP4i_JO1Q4U" />

    <!-- Canonical & Hreflang -->
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {isHome && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={altLang} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Antonio" />
    <meta property="profile:last_name" content="Payá González" />
    <meta property="profile:username" content="antoniopaya22" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="Antonio Payá González" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- JSON-LD Structured Data -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <title>{title}</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skip}</a>
    <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
    <slot />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #F5F6F2;
    --bg-2: #ECEEE8;
    --surface: #FFFFFF;
    --surface-2: #F1F3EE;
    --text: #0B0F14;
    --text-2: #2E3640;
    --muted: #5A6470;
    --line: rgba(11, 15, 20, 0.1);
    --line-strong: rgba(11, 15, 20, 0.22);
    --accent: #3F6B00;
    --accent-2: #0E7490;
    --accent-glow: rgba(63, 107, 0, 0.16);
    --on-accent: #FFFFFF;
    --syn-key: #B4237A;
    --syn-str: #3F6B00;
    --syn-num: #B45309;
    --syn-prop: #0E7490;
    --syn-com: #6B7280;
    --grid: rgba(11, 15, 20, 0.05);
    --shadow: 0 1px 0 rgba(11, 15, 20, 0.04), 0 24px 48px -28px rgba(11, 15, 20, 0.35);
    color-scheme: light;

    --display: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif;
    --sans: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, 'SFMono-Regular', monospace;
    --wrap: 1240px;
    --gutter: clamp(16px, 4vw, 40px);
    --r: 14px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  :root:not([data-theme="light"]) {
    --bg: #07090C;
    --bg-2: #0B0E13;
    --surface: #0F1319;
    --surface-2: #141A21;
    --text: #E8EDF2;
    --text-2: #B9C2CC;
    --muted: #7D8794;
    --line: rgba(232, 237, 242, 0.08);
    --line-strong: rgba(232, 237, 242, 0.18);
    --accent: #B6FF3B;
    --accent-2: #5CE1E6;
    --accent-glow: rgba(182, 255, 59, 0.14);
    --on-accent: #07090C;
    --syn-key: #FF7AB6;
    --syn-str: #B6FF3B;
    --syn-num: #FFB86B;
    --syn-prop: #7DD3FC;
    --syn-com: #5F6B78;
    --grid: rgba(232, 237, 242, 0.04);
    --shadow: 0 1px 0 rgba(0, 0, 0, 0.3), 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    color-scheme: dark;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  ::selection { background: var(--accent); color: var(--on-accent); }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  button { font: inherit; color: inherit; }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gutter); }

  .mono { font-family: var(--mono); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .accent { color: var(--accent); }

  .prose a, a.link {
    color: var(--text);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s var(--ease), color 0.2s;
  }

  .prose a:hover, a.link:hover { color: var(--accent); }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose em { font-style: normal; color: var(--accent-2); font-family: var(--mono); font-size: 0.92em; }

  /* buttons */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .btn svg { transition: transform 0.3s var(--ease); }
  .btn:hover svg { transform: translateX(3px); }

  .btn-primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .btn-primary:hover { box-shadow: 0 0 0 4px var(--accent-glow), 0 10px 30px -10px var(--accent); }

  .btn-ghost { background: color-mix(in srgb, var(--surface) 60%, transparent); backdrop-filter: blur(8px); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  .kbd {
    font-family: var(--mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .chip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text-2);
    white-space: nowrap;
  }

  /* cards with cursor spotlight */
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, -200%), var(--accent-glow), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .card:hover { border-color: var(--line-strong); }
  .card:hover::before { opacity: 1; }

  /* sections */
  .section { position: relative; padding: clamp(5rem, 10vw, 8rem) 0; }

  .section-body { min-width: 0; }

  /* window chrome (terminal / editor) */
  .win {
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .dots { display: flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); }
  .dots i:nth-child(1) { background: #FF5F57; }
  .dots i:nth-child(2) { background: #FEBC2E; }
  .dots i:nth-child(3) { background: #28C840; }

  /* syntax tokens */
  .k { color: var(--syn-key); }
  .s { color: var(--syn-str); }
  .n { color: var(--syn-num); }
  .p { color: var(--syn-prop); }
  .c { color: var(--syn-com); font-style: italic; }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  /* skip link */
  .skip-link {
    position: fixed; top: -100px; left: 1rem; z-index: 1000;
    padding: 0.7rem 1.2rem; background: var(--accent); color: var(--on-accent);
    border-radius: 10px; font-family: var(--mono); font-size: 0.85rem; transition: top 0.2s;
  }
  .skip-link:focus { top: 1rem; }

  /* scroll progress */
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; pointer-events: none; }
  .progress span {
    display: block; height: 100%; width: 100%;
    background: linear-gradient(90deg, var(--accent-2), var(--accent));
    transform-origin: 0 50%; transform: scaleX(0);
  }

  /* ambient cursor glow */
  .cursor-glow {
    position: fixed;
    left: 0;
    top: 0;
    width: 600px;
    height: 600px;
    margin: -300px 0 0 -300px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow), transparent 65%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.6s;
    will-change: transform;
  }

  .cursor-glow.on { opacity: 0.7; }

  main, header, footer { position: relative; z-index: 1; }

  /* toast */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 2.5rem;
    z-index: 90;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    padding: 0.7rem 1.1rem;
    border-radius: 10px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.8rem;
    transition: opacity 0.3s, transform 0.4s var(--ease);
  }

  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* reveal on scroll — visible without JS. Until the motion module boots (class
     "motion" on <html>) the elements wait hidden; if it never does, they show anyway. */
  .js:not(.motion) .reveal { opacity: 0; animation: reveal-failsafe 0.4s 4s forwards; }
  @keyframes reveal-failsafe { to { opacity: 1; } }
  .rv-wait { transition: none !important; }

  /* theme switch: the new theme grows as a circle from the toggle */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
  ::view-transition-new(root) { animation: theme-reveal 0.65s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes theme-reveal {
    from { clip-path: circle(0 at var(--vx, 50%) var(--vy, 50%)); }
    to { clip-path: circle(150vmax at var(--vx, 50%) var(--vy, 50%)); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
    .js:not(.motion) .reveal { opacity: 1; animation: none; }
    ::view-transition-new(root) { animation: none; }
    .cursor-glow { display: none; }
  }
</style>

<script>
  import '../scripts/motion';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // spotlight cards
  document.addEventListener('pointermove', (e) => {
    const card = (e.target as HTMLElement).closest?.('.card') as HTMLElement | null;
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', `${e.clientX - r.left}px`);
    card.style.setProperty('--my', `${e.clientY - r.top}px`);
  }, { passive: true });

  // toast + clipboard helpers
  const toastEl = document.getElementById('toast');
  let toastTimer: number | undefined;
  (window as any).__toast = (msg: string) => {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2200);
  };

  // theme helper: with View Transitions the new theme expands from the click point
  (window as any).__toggleTheme = (origin?: { x: number; y: number }) => {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (reduced || !doc.startViewTransition) { apply(); return; }
    root.style.setProperty('--vx', `${origin?.x ?? innerWidth / 2}px`);
    root.style.setProperty('--vy', `${origin?.y ?? innerHeight / 2}px`);
    doc.startViewTransition(apply);
  };

  // scroll progress
  const bar = document.getElementById('progress-bar');
  let ticking = false;
  const update = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
    ticking = false;
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
</script>
