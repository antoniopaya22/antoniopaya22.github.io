---
import { t, ids, type Lang } from '../i18n/translations';
import { site, profiles } from '../data/site';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.contact;
---

<section class="contact" id={id.contact}>
  <div class="wrap">
    <span class="mono c-n reveal">§ {s.n} — {s.title}</span>
    <h2 class="c-heading reveal" style="--d: 0.05s">{i.contact.heading}</h2>

    <div class="c-grid">
      <div class="c-main">
        <p class="c-text reveal" style="--d: 0.1s">{i.contact.text}</p>
        <div class="c-mail reveal" style="--d: 0.15s">
          <a href={`mailto:${site.email}`} class="c-mail-link">
            {site.email}
            <svg class="arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
          <button type="button" class="c-copy mono" data-copy={site.email} data-label={i.contact.copy} data-done={i.contact.copied}>{i.contact.copy}</button>
        </div>
      </div>

      <div class="c-side reveal" style="--d: 0.2s">
        <h3 class="mono c-side-title">{i.contact.elsewhere}</h3>
        <ul class="c-links">
          {profiles.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="c-link">
                <span class="c-link-label">{p.label}</span>
                <span class="mono c-link-handle">{p.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 6rem);
    position: relative;
    overflow: hidden;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--paper) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--paper) 6%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 80% at 85% 20%, #000 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 85% 20%, #000 20%, transparent 70%);
    pointer-events: none;
  }

  .contact .wrap { position: relative; }

  .c-n {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent);
  }

  .c-n::after { content: ''; width: 2.5rem; height: 1px; background: var(--accent); }

  .c-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(4rem, 13vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 1.25rem 0 clamp(2.5rem, 5vw, 4rem);
  }

  .c-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .c-text {
    font-size: 1.15rem;
    max-width: 46ch;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    margin-bottom: 2rem;
  }

  .c-mail { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.25rem; }

  .c-mail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 4vw, 3rem);
    line-height: 1.1;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
    padding-bottom: 0.3rem;
    transition: color 0.25s, border-color 0.25s;
    overflow-wrap: anywhere;
  }

  .c-mail-link:hover { color: var(--accent); border-color: var(--accent); }
  .c-mail-link:hover .arrow { transform: translate(4px, -4px); }

  .c-copy {
    font-size: 0.68rem;
    padding: 0.5rem 0.9rem;
    background: transparent;
    color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .c-copy:hover { border-color: var(--paper); }
  .c-copy.done { color: var(--accent); border-color: var(--accent); }

  .c-side-title {
    font-size: 0.66rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
  }

  .c-links { list-style: none; }

  .c-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
    transition: padding 0.3s var(--ease), color 0.2s;
  }

  .c-link:hover { color: var(--accent); padding-left: 0.5rem; }
  .c-link-label { font-weight: 500; }
  .c-link-handle { font-size: 0.64rem; color: color-mix(in srgb, var(--paper) 50%, transparent); text-transform: none; letter-spacing: 0.02em; }

  @media (max-width: 900px) {
    .c-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        btn.textContent = btn.dataset.done || 'OK';
        btn.classList.add('done');
        setTimeout(() => {
          btn.textContent = btn.dataset.label || '';
          btn.classList.remove('done');
        }, 1800);
      } catch (e) {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>
