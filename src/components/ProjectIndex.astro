---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { altLang, langPath, type Lang } from '../i18n/translations';
import { getProjects, projectPath, projectsIndexPath, projectStrings, siteUrl, slugOf } from '../data/projects';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const s = projectStrings[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projects = await getProjects(lang);
const indexPath = projectsIndexPath(lang);
const altPath = projectsIndexPath(altLang(lang));
const pageUrl = `${siteUrl}${indexPath}`;

const graph = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    url: pageUrl,
    name: s.indexTitle,
    description: s.indexDescription,
    inLanguage: lang,
    isPartOf: { '@id': `${siteUrl}/#website` },
    author: { '@id': `${siteUrl}/#person` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${projectPath(lang, slugOf(p))}`,
      })),
    },
  },
];
---

<Layout title={s.indexTitle} description={s.indexDescription} lang={lang} alternate={`${siteUrl}${altPath}`} jsonLd={graph}>
  <Header lang={lang} alt={altPath} home={false} />
  <main id="main-content" class="pi wrap">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href={langPath(lang, base)}>~/antonio-paya</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{s.section.toLowerCase()}</span>
    </nav>
    <h1 class="pi-title">{s.section}</h1>
    <p class="pi-lead">{s.indexLead}</p>

    <ul class="pi-list">
      {projects.map((p) => (
        <li>
          <a class="pi-card card" href={projectPath(lang, slugOf(p))}>
            <span class="pi-meta mono">
              <span class={`kind kind-${p.data.kind}`}>{s.kind[p.data.kind]}</span>
              <span>{p.data.year}</span>
            </span>
            <span class="pi-name">{p.data.title}</span>
            <span class="pi-tag">{p.data.tagline}</span>
            <span class="pi-stack">{p.data.stack.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</span>
            <span class="pi-go mono">{s.open} →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .pi { padding-top: clamp(6.5rem, 12vw, 9rem); padding-bottom: clamp(4rem, 8vw, 6rem); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.78rem; color: var(--muted); margin-bottom: 2rem; }
  .crumbs a { color: var(--accent-2); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--text-2); }
  .pi-title { font-family: var(--display); font-weight: 700; font-size: clamp(2.8rem, 8vw, 5.5rem); line-height: 0.95; letter-spacing: -0.035em; }
  .pi-lead { color: var(--text-2); font-size: clamp(1.05rem, 2vw, 1.25rem); max-width: 56ch; margin: 1.2rem 0 3rem; line-height: 1.55; }
  .pi-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .pi-list li { display: flex; }
  .pi-card { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.4rem 1.5rem; width: 100%; }
  .pi-card:hover { transform: translateY(-4px); }
  .pi-meta { display: flex; gap: 0.9rem; align-items: center; font-size: 0.75rem; color: var(--muted); }
  .kind { padding: 0.15rem 0.55rem; border-radius: 6px; border: 1px solid currentColor; }
  .kind-research { color: var(--syn-num); }
  .kind-oss { color: var(--accent); }
  .kind-product { color: var(--accent-2); }
  .pi-name { font-family: var(--display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; color: var(--text); }
  .pi-tag { color: var(--text-2); line-height: 1.5; }
  .pi-stack { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.3rem; }
  .pi-go { margin-top: auto; padding-top: 0.6rem; font-size: 0.78rem; color: var(--accent-2); }
  .pi-card:hover .pi-go { color: var(--accent); }
  @media (max-width: 760px) { .pi-list { grid-template-columns: minmax(0, 1fr); } }
</style>
