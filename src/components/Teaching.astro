---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
const s = i.sections.teaching;
const k = lang === 'es' ? { level: 'nivel', credits: 'créditos', type: 'tipo', official: 'oficial' } : { level: 'level', credits: 'credits', type: 'type', official: 'official' };
---

<section class="section teaching" id={id.teaching}>
  <div class="wrap">
    <SectionHead n={s.n} file={s.file} title={s.title} desc={s.desc} />

    <div class="inst reveal">
      <div class="inst-logo">
        <img src={`${base}images/logo-unir.png`} alt="UNIR" width="240" height="107" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="inst-name">{i.teaching.institution}</p>
        <p class="mono inst-since"><span class="accent">●</span> {i.teaching.since}</p>
      </div>
    </div>

    <ul class="programs">
      {i.teaching.programs.map((p, idx) => (
        <li class="reveal" style={`--d: ${idx * 0.08}s`}>
          <a class="program card" href={p.url} target="_blank" rel="noopener noreferrer">
            <span class="p-num" aria-hidden="true">0{idx + 1}</span>
            <dl class="p-meta mono">
              <div><dt>{k.level}:</dt><dd class="s">{p.level}</dd></div>
              <div><dt>{k.credits}:</dt><dd class="n">{p.meta.split('·')[1]?.trim()}</dd></div>
              <div><dt>{k.type}:</dt><dd class="s">{k.official}</dd></div>
            </dl>
            <h3 class="p-title">{p.title}</h3>
            <span class="p-cta mono">
              {i.teaching.linkLabel}
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="note mono reveal"><span class="c">// {i.teaching.note}</span></p>
  </div>
</section>

<style>
  .inst { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.75rem; }

  .inst-logo {
    width: 84px;
    height: 50px;
    padding: 8px 11px;
    background: #fff;
    border-radius: 10px;
    display: grid;
    place-items: center;
  }

  .inst-logo img { width: 100%; height: 100%; object-fit: contain; }
  .inst-name { font-weight: 600; }
  .inst-since { font-size: 0.72rem; color: var(--muted); }

  .programs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .programs li { display: flex; }

  .program {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 1.5rem 1.4rem 1.4rem;
    min-height: 300px;
  }

  .program:hover { transform: translateY(-5px); }

  .p-num {
    position: absolute;
    right: 1rem;
    top: 0.2rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 5.5rem;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    transition: -webkit-text-stroke-color 0.3s;
  }

  .program:hover .p-num { -webkit-text-stroke-color: var(--accent); }

  .p-meta { font-size: 0.75rem; margin-bottom: 1.4rem; display: grid; gap: 0.1rem; }
  .p-meta div { display: flex; gap: 0.5rem; }
  .p-meta dt { color: var(--syn-prop); }

  .p-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2vw, 1.55rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  .p-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .program:hover .p-cta { color: var(--accent); }
  .program:hover .arrow { transform: translate(3px, -3px); }

  .note { margin-top: 1.75rem; font-size: 0.8rem; }

  @media (max-width: 900px) {
    .programs { grid-template-columns: minmax(0, 1fr); }
    .program { min-height: 0; }
  }
</style>
