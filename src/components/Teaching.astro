---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
const s = i.sections.teaching;
---

<section class="section teaching" id={id.teaching}>
  <div class="wrap section-grid">
    <SectionHead n={s.n} title={s.title} desc={s.desc} />

    <div class="section-body">
      <div class="inst reveal">
        <div class="inst-logo">
          <img src={`${base}images/logo-unir.png`} alt="UNIR" width="240" height="107" loading="lazy" decoding="async" />
        </div>
        <div>
          <p class="inst-name">{i.teaching.institution}</p>
          <p class="mono inst-since">{i.teaching.since}</p>
        </div>
      </div>

      <ol class="programs">
        {i.teaching.programs.map((p, idx) => (
          <li class="reveal" style={`--d: ${idx * 0.07}s`}>
            <a class="program" href={p.url} target="_blank" rel="noopener noreferrer">
              <span class="program-n serif">{String(idx + 1).padStart(2, '0')}</span>
              <span class="program-body">
                <span class="mono program-level">{p.level} · {p.meta}</span>
                <span class="program-title">{p.title}</span>
              </span>
              <span class="program-cta mono">
                <span class="program-cta-label">{i.teaching.linkLabel}</span>
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <p class="note reveal">{i.teaching.note}</p>
    </div>
  </div>
</section>

<style>
  .inst {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }

  .inst-logo {
    width: 88px;
    height: 52px;
    padding: 9px 12px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
    display: grid;
    place-items: center;
  }

  .inst-logo img { width: 100%; height: 100%; object-fit: contain; }

  .inst-name { font-weight: 600; }
  .inst-since { font-size: 0.66rem; color: var(--muted); margin-top: 0.15rem; }

  .programs { list-style: none; border-top: 1px solid var(--ink); }

  .program {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.35s var(--ease), padding 0.35s var(--ease);
  }

  .program:hover {
    background: var(--accent-soft);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .program-n {
    font-size: 3rem;
    line-height: 1;
    color: var(--muted);
    transition: color 0.3s;
  }

  .program:hover .program-n { color: var(--accent); }

  .program-body { display: flex; flex-direction: column; gap: 0.35rem; }

  .program-level { font-size: 0.66rem; color: var(--muted); }

  .program-title {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.3vw, 1.9rem);
    line-height: 1.12;
  }

  .program-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .program:hover .program-cta { color: var(--accent); }
  .program:hover .arrow { transform: translate(3px, -3px); }

  .note {
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .program { grid-template-columns: 2.75rem minmax(0, 1fr) auto; gap: 1rem; }
    .program-n { font-size: 2rem; }
    .program-cta-label { display: none; }
  }
</style>
