---
import { t, ids, altLang, langPath, navSections, type Lang } from '../i18n/translations';
import { site, profiles } from '../data/site';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);

const groups = [
  {
    label: i.ui.paletteGroups.nav,
    items: navSections.map((k) => ({ label: i.sections[k].title, hint: i.sections[k].file, action: 'go', value: `#${id[k]}` })),
  },
  {
    label: i.ui.paletteGroups.actions,
    items: [
      { label: i.ui.paletteActions.theme, hint: 'theme', action: 'theme', value: '' },
      { label: i.ui.paletteActions.lang, hint: altLang(lang).toUpperCase(), action: 'url', value: langPath(altLang(lang), base) },
      { label: i.ui.paletteActions.email, hint: site.email, action: 'copy', value: site.email },
      { label: i.ui.paletteActions.cv, hint: 'PDF', action: 'download', value: `${base}${site.cv}` },
      { label: i.ui.paletteActions.top, hint: '↑', action: 'go', value: '#' },
    ],
  },
  {
    label: i.ui.paletteGroups.links,
    items: profiles.map((p) => ({ label: p.label, hint: p.handle, action: 'ext', value: p.href })),
  },
];
---

<dialog class="pal" id="palette" aria-label={i.ui.paletteOpen} data-copied={i.ui.toastCopied}>
  <div class="pal-box">
    <div class="pal-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="pal-input" type="text" placeholder={i.ui.paletteHint} autocomplete="off" spellcheck="false" aria-controls="pal-list" />
      <span class="kbd">esc</span>
    </div>
    <div class="pal-list" id="pal-list" role="listbox">
      {groups.map((g) => (
        <div class="pal-group" role="group" aria-label={g.label}>
          <p class="pal-glabel mono">{g.label}</p>
          {g.items.map((it) => (
            <button type="button" class="pal-item" role="option" data-action={it.action} data-value={it.value} data-search={`${it.label} ${it.hint}`.toLowerCase()}>
              <span class="pal-chev mono" aria-hidden="true">❯</span>
              <span class="pal-label">{it.label}</span>
              <span class="pal-hint mono">{it.hint}</span>
            </button>
          ))}
        </div>
      ))}
      <p class="pal-empty mono" hidden>{i.ui.paletteEmpty}</p>
    </div>
    <div class="pal-foot mono">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> {lang === 'es' ? 'navegar' : 'navigate'}</span>
      <span><span class="kbd">↵</span> ok</span>
    </div>
  </div>
</dialog>

<style>
  .pal {
    margin: 12vh auto auto;
    width: min(620px, calc(100vw - 32px));
    max-height: 70vh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  .pal::backdrop {
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(6px);
  }

  .pal[open] .pal-box { animation: pal-in 0.25s var(--ease); }

  @keyframes pal-in {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .pal-box {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: var(--shadow), 0 0 0 1px var(--accent-glow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .pal-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .pal-search input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }

  .pal-list { overflow-y: auto; padding: 0.4rem; }

  .pal-glabel { font-size: 0.66rem; color: var(--muted); padding: 0.7rem 0.75rem 0.35rem; text-transform: uppercase; letter-spacing: 0.08em; }

  .pal-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .pal-item[hidden], .pal-group[hidden], .pal-empty[hidden] { display: none; }

  .pal-chev { color: transparent; font-size: 0.75rem; }
  .pal-label { flex: 1; }
  .pal-hint { font-size: 0.7rem; color: var(--muted); }

  .pal-item.is-active { background: var(--surface-2); }
  .pal-item.is-active .pal-chev { color: var(--accent); }
  .pal-item.is-active .pal-label { color: var(--accent); }

  .pal-empty { padding: 1.5rem; text-align: center; color: var(--muted); font-size: 0.8rem; }

  .pal-foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.66rem;
    color: var(--muted);
  }
</style>

<script>
  const dlg = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('pal-input') as HTMLInputElement;
  const items = Array.from(dlg.querySelectorAll<HTMLButtonElement>('.pal-item'));
  const empty = dlg.querySelector<HTMLElement>('.pal-empty')!;
  let active = 0;

  const visible = () => items.filter((b) => !b.hidden);

  const setActive = (idx: number) => {
    const v = visible();
    if (!v.length) return;
    active = (idx + v.length) % v.length;
    items.forEach((b) => b.classList.remove('is-active'));
    v[active].classList.add('is-active');
    v[active].scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((b) => (b.hidden = !!q && !q.split(/\s+/).every((w) => b.dataset.search!.includes(w))));
    dlg.querySelectorAll<HTMLElement>('.pal-group').forEach((g) => {
      g.hidden = !g.querySelector('.pal-item:not([hidden])');
    });
    empty.hidden = visible().length > 0;
    setActive(0);
  };

  const open = () => {
    if (dlg.open) return;
    input.value = '';
    filter();
    dlg.showModal();
    input.focus();
  };

  const close = () => dlg.open && dlg.close();

  const exec = (b: HTMLButtonElement) => {
    const { action, value } = b.dataset;
    close();
    switch (action) {
      case 'go':
        if (value === '#') window.scrollTo({ top: 0, behavior: 'smooth' });
        else document.querySelector(value!)?.scrollIntoView({ behavior: 'smooth' });
        break;
      case 'theme': (window as any).__toggleTheme?.(); break;
      case 'url': window.location.href = value!; break;
      case 'ext': window.open(value, '_blank', 'noopener'); break;
      case 'copy':
        navigator.clipboard?.writeText(value!).then(() => (window as any).__toast?.(dlg.dataset.copied));
        break;
      case 'download': {
        const a = document.createElement('a');
        a.href = value!; a.download = ''; document.body.appendChild(a); a.click(); a.remove();
        break;
      }
    }
  };

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? close() : open(); }
  });

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); const v = visible()[active]; if (v) exec(v); }
  });

  items.forEach((b) => {
    b.addEventListener('click', () => exec(b));
    b.addEventListener('pointermove', () => setActive(visible().indexOf(b)));
  });

  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
</script>
