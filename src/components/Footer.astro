---
import { t, type Lang } from '../i18n/translations';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const now = new Date();
const updated = now.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { month: 'long', year: 'numeric' });
---

<footer class="ftr">
  <div class="wrap ftr-inner">
    <p class="ftr-name"><span class="serif">Antonio Payá González</span> <span class="ftr-role">— {i.footer.role}</span></p>
    <p class="mono ftr-meta">© {now.getFullYear()} · {i.footer.updated} {updated}</p>
    <a href="#" class="mono ftr-top">{i.footer.top} ↑</a>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ink);
    color: color-mix(in srgb, var(--paper) 65%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
  }

  .ftr-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .ftr-name .serif { font-size: 1.15rem; color: var(--paper); }
  .ftr-role { font-size: 0.88rem; }
  .ftr-meta, .ftr-top { font-size: 0.64rem; }
  .ftr-top { color: var(--paper); transition: color 0.2s; }
  .ftr-top:hover { color: var(--accent); }
</style>
