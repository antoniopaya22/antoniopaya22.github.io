---
import { t, ids, altLang, langPath, navSections, type Lang } from '../i18n/translations';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
const other = altLang(lang);
const otherPath = langPath(other, base);
const links = navSections.map((key) => ({ href: `#${id[key]}`, label: i.sections[key].title, n: i.sections[key].n }));
---

<header class="hdr" id="hdr">
  <div class="hdr-inner wrap">
    <a href={langPath(lang, base)} class="brand mono" aria-label={i.header.home}>
      <span class="brand-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 7 5 5-5 5M13 18h7"/></svg>
      </span>
      <span class="brand-path"><span class="brand-tilde">~/</span>antonio-paya</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {links.map((l) => (
          <li><a href={l.href} class="nav-link mono" data-nav><span class="nav-dot">./</span>{l.label.toLowerCase()}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr-tools">
      <button class="tool tool-k mono" type="button" data-palette-open aria-label={i.ui.paletteOpen}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="kbd" data-kbd>Ctrl K</span>
      </button>
      <a href={otherPath} class="tool mono" hreflang={other} lang={other} title={i.header.switchLang}>{other.toUpperCase()}</a>
      <button class="tool" type="button" data-theme-toggle aria-label={i.header.theme} title={i.header.theme}>
        <svg class="i-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="i-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
      <button class="tool tool-menu" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={i.header.menu}>
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="wrap">
      {links.map((l) => (
        <li><a href={l.href} class="m-link"><span class="mono">{l.n}</span>{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s var(--ease), border-color 0.35s;
  }

  .hdr.is-scrolled, .hdr.menu-open {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border-bottom-color: var(--line);
  }

  .hdr-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; height: 68px; }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; font-weight: 500; flex-shrink: 0; }

  .brand-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.4s var(--ease);
  }

  .brand:hover .brand-icon { transform: rotate(-10deg) scale(1.05); }
  .brand-tilde { color: var(--muted); }

  .nav-list { display: flex; list-style: none; gap: 0.1rem; }

  .nav-link {
    display: inline-flex;
    padding: 0.4rem 0.6rem;
    font-size: 0.78rem;
    color: var(--muted);
    border-radius: 7px;
    transition: color 0.2s, background-color 0.2s;
  }

  .nav-dot { color: transparent; transition: color 0.2s; margin-right: 1px; }
  .nav-link:hover { color: var(--text); background: var(--surface-2); }
  .nav-link.is-active { color: var(--accent); }
  .nav-link:hover .nav-dot, .nav-link.is-active .nav-dot { color: var(--accent); }

  .hdr-tools { display: flex; align-items: center; gap: 0.4rem; }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 34px;
    min-width: 34px;
    padding: 0 0.6rem;
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .tool:hover { border-color: var(--accent); color: var(--accent); }
  .tool-k { color: var(--muted); }

  .i-sun { display: none; }
  :global(:root[data-theme="light"]) .i-sun { display: block; }
  :global(:root[data-theme="light"]) .i-moon { display: none; }

  .tool-menu { display: none; }

  .burger { display: grid; gap: 5px; width: 16px; }
  .burger i { display: block; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease); }
  .menu-open .burger i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu-open .burger i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mobile-menu { height: calc(100dvh - 68px); overflow-y: auto; border-top: 1px solid var(--line); }
  .mobile-menu ul { list-style: none; padding-top: 1.25rem; padding-bottom: 2rem; }

  .m-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .m-link .mono { font-size: 0.72rem; color: var(--accent); font-weight: 400; letter-spacing: 0; }

  @media (max-width: 1100px) {
    .nav { display: none; }
    .tool-menu { display: inline-flex; }
  }

  @media (max-width: 480px) {
    .tool-k .kbd { display: none; }
    .brand-tilde { display: none; }
  }
</style>

<script>
  const hdr = document.getElementById('hdr');
  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // platform-aware shortcut label
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = '⌘ K'));
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => (window as any).__toggleTheme())
  );

  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    hdr?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const spy = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle('is-active', l.getAttribute('href') === `#${e.target.id}`));
    }),
    { rootMargin: '-45% 0px -50% 0px' }
  );
  document.querySelectorAll('main section[id]').forEach((s) => spy.observe(s));
</script>
