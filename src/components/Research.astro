---
import { t, ids, type Lang } from '../i18n/translations';
import { publications, profiles } from '../data/site';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.research;
const academic = profiles.filter((p) => ['Google Scholar', 'ORCID', 'ResearchGate'].includes(p.label));
---

<section class="section" id={id.research}>
  <div class="wrap">
    <SectionHead n={s.n} file={s.file} title={s.title} desc={s.desc} />

    <div class="r-top">
      <div class="thesis card reveal">
        <span class="mono thesis-l"><span class="accent">❯</span> {i.research.thesisLabel}</span>
        <p class="thesis-t">{i.research.thesis}</p>
        <ul class="r-profiles mono">
          {academic.map((p) => (
            <li><a href={p.href} target="_blank" rel="noopener noreferrer">{p.label} ↗</a></li>
          ))}
        </ul>
      </div>
      <ul class="r-metrics">
        {i.research.metrics.map((m, idx) => (
          <li class="card reveal" style={`--d: ${0.08 * idx}s`}>
            <span class="r-v" data-count={m.value}>{m.value}</span>
            <span class="mono r-l">{m.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <h3 class="list-title mono reveal"><span class="accent">#</span> {i.research.pubsTitle}</h3>
    <ol class="pubs">
      {publications.map((p, idx) => (
        <li class="reveal" style={`--d: ${idx * 0.05}s`}>
          <a class="pub card" href={p.url} target="_blank" rel="noopener noreferrer">
            <span class="pub-year" aria-hidden="true">{p.year}</span>
            <span class="pub-body">
              <span class="pub-key mono">@article<span class="dim">{'{'}</span>paya{p.year}{p.title.split(/[\s:]/)[0].toLowerCase().replace(/[^a-z]/g, '')}<span class="dim">,</span></span>
              <span class="pub-title">{p.title}</span>
              <span class="pub-venue"><span class="p mono">journal</span> {p.journal} <span class="pub-pub mono">{p.publisher}</span></span>
              <span class="pub-tags">{p.tags.map((tag) => <span class="chip">{tag}</span>)}</span>
            </span>
            <svg class="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </li>
      ))}
    </ol>

    <h3 class="list-title mono reveal"><span class="accent">#</span> {i.research.articlesTitle}</h3>
    <ul class="arts">
      {i.research.articles.map((a, idx) => (
        <li class="reveal" style={`--d: ${idx * 0.05}s`}>
          <a class="art" href={a.url} target="_blank" rel="noopener noreferrer">
            <span class="art-year mono">{a.year}</span>
            <span class="art-title">{a.title}</span>
            <span class="art-venue mono">{a.venue}</span>
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .r-top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .thesis { padding: 1.6rem 1.7rem; }
  .thesis-l { font-size: 0.75rem; color: var(--muted); }

  .thesis-t {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0.8rem 0 1.4rem;
  }

  .r-profiles { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem; }
  .r-profiles a {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    transition: border-color 0.2s, color 0.2s;
  }
  .r-profiles a:hover { border-color: var(--accent); color: var(--accent); }

  .r-metrics { list-style: none; display: grid; gap: 1rem; grid-template-rows: repeat(3, 1fr); }
  .r-metrics li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.2rem; }
  .r-v { font-family: var(--display); font-weight: 700; font-size: 2.2rem; letter-spacing: -0.04em; line-height: 1; }
  .r-l { font-size: 0.72rem; color: var(--muted); }

  .list-title { font-size: 0.85rem; color: var(--text-2); font-weight: 500; margin-bottom: 1rem; }

  .pubs { list-style: none; display: grid; gap: 0.75rem; margin-bottom: clamp(3rem, 6vw, 4rem); }

  .pub {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.4rem 1.5rem;
  }

  .pub-year {
    font-family: var(--display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    transition: -webkit-text-stroke-color 0.3s, color 0.3s;
  }

  .pub:hover .pub-year { -webkit-text-stroke-color: var(--accent); }

  .pub-body { display: flex; flex-direction: column; gap: 0.45rem; }
  .pub-key { font-size: 0.72rem; color: var(--syn-key); }
  .dim { color: var(--muted); }

  .pub-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
    transition: color 0.2s;
  }

  .pub:hover .pub-title { color: var(--accent); }

  .pub-venue { font-size: 0.92rem; color: var(--text-2); display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .pub-venue .p { font-size: 0.72rem; }
  .pub-pub { font-size: 0.68rem; color: var(--muted); padding: 0.05rem 0.4rem; border: 1px solid var(--line); border-radius: 4px; }
  .pub-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.2rem; }

  .pub .arrow, .art .arrow { color: var(--muted); transition: transform 0.3s var(--ease), color 0.2s; }
  .pub:hover .arrow, .art:hover .arrow { color: var(--accent); transform: translate(3px, -3px); }

  .arts { list-style: none; border-top: 1px solid var(--line); }

  .art {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
    gap: 1.25rem;
    align-items: center;
    padding: 0.95rem 0.25rem;
    border-bottom: 1px solid var(--line);
    transition: padding 0.3s var(--ease), background-color 0.3s;
  }

  .art:hover { background: var(--surface); padding-left: 0.9rem; padding-right: 0.9rem; }
  .art-year { font-size: 0.75rem; color: var(--syn-num); }
  .art-title { font-weight: 500; }
  .art-venue { font-size: 0.72rem; color: var(--muted); }

  @media (max-width: 900px) {
    .r-top { grid-template-columns: minmax(0, 1fr); }
    .r-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: none; }
    .r-metrics li { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
  }

  @media (max-width: 640px) {
    .pub { grid-template-columns: minmax(0, 1fr) auto; gap: 0.6rem 1rem; padding: 1.2rem; }
    .pub-year { grid-column: 1 / -1; font-size: 2.2rem; }
    .art { grid-template-columns: 3rem minmax(0, 1fr) auto; }
    .art-venue { display: none; }
  }
</style>
