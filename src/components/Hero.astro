---
import { t, ids, type Lang } from '../i18n/translations';
import { site } from '../data/site';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="wrap">
    <div class="hero-top">
      <span class="mono hero-kicker l1">{i.hero.kicker}</span>
      <span class="mono hero-status l1"><span class="dot" aria-hidden="true"></span>{i.hero.status}</span>
    </div>

    <div class="hero-main">
      <div class="hero-copy">
        <h1 class="hero-name" id="hero-name">
          <span class="line"><span class="l2">Antonio Payá</span></span>
          <span class="line"><span class="l3"><em>González</em></span></span>
        </h1>

        <p class="hero-statement serif-em l4" set:html={i.hero.statement} />
        <p class="hero-intro l5">{i.hero.intro}</p>

        <div class="hero-ctas l6">
          <a href={`#${id.contact}`} class="btn btn-solid">
            {i.hero.ctaPrimary}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={`${base}${site.cv}`} class="btn btn-ghost" download>
            {i.hero.ctaCv}
            <svg class="down" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 12l6 6 6-6M5 21h14"/></svg>
          </a>
        </div>
      </div>

      <figure class="hero-figure l4">
        <div class="frame">
          <img src={`${base}images/foto1.webp`} alt="Antonio Payá González" width="686" height="911" fetchpriority="high" decoding="async" />
          <span class="corner c1" aria-hidden="true"></span>
          <span class="corner c2" aria-hidden="true"></span>
          <span class="corner c3" aria-hidden="true"></span>
          <span class="corner c4" aria-hidden="true"></span>
        </div>
        <figcaption class="mono">{i.hero.figure}</figcaption>
      </figure>
    </div>

    <dl class="spec l7">
      {i.hero.spec.map((row) => (
        <div class="spec-cell">
          <dt class="mono">{row.k}</dt>
          <dd>
            <span class="spec-v">{row.v}</span>
            <span class="spec-s">{row.s}</span>
          </dd>
        </div>
      ))}
    </dl>

    <ul class="metrics" aria-label="Key figures">
      {i.hero.metrics.map((m, idx) => (
        <li class="metric reveal" style={`--d: ${idx * 0.06}s`}>
          <span class="metric-v">{m.value}</span>
          <span class="metric-l mono">{m.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: calc(72px + clamp(2.5rem, 6vw, 4.5rem)) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero .wrap { position: relative; }

  .hero-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }

  .hero-status { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink-2); }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2F9E5B;
    box-shadow: 0 0 0 0 rgba(47, 158, 91, 0.5);
    animation: ping 2.4s var(--ease) infinite;
  }

  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(47, 158, 91, 0.45); }
    70%, 100% { box-shadow: 0 0 0 8px rgba(47, 158, 91, 0); }
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .hero-name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.6rem, 10.5vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: -0.025em;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero-name .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero-name .line > span { display: inline-block; }
  .hero-name em { font-style: italic; color: var(--accent); }

  .hero-statement {
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin-bottom: 1.25rem;
    color: var(--ink);
  }

  .hero-statement :global(em) { color: var(--accent); }

  .hero-intro {
    color: var(--muted);
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* figure */
  .hero-figure { justify-self: end; width: 100%; max-width: 380px; }

  .frame {
    position: relative;
    aspect-ratio: 686 / 911;
    background: var(--paper-3);
    padding: 10px;
    border: 1px solid var(--rule);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.8s var(--ease);
  }

  .hero-figure:hover .frame img { filter: grayscale(0) contrast(1); }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }

  .c1 { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .c2 { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .c3 { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .c4 { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .hero-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.66rem;
    color: var(--muted);
  }

  /* spec sheet */
  .spec {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .spec-cell {
    padding: 1.1rem 1.25rem 1.2rem;
    border-left: 1px solid var(--rule);
  }

  .spec-cell:first-child { border-left: 0; padding-left: 0; }

  .spec dt { font-size: 0.66rem; color: var(--muted); margin-bottom: 0.45rem; }

  .spec dd { display: flex; flex-direction: column; }

  .spec-v { font-weight: 600; font-size: 1rem; line-height: 1.3; }
  .spec-s { color: var(--muted); font-size: 0.88rem; }

  /* metrics */
  .metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 1rem;
  }

  .metric-v {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5vw, 4.25rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .metric-l { font-size: 0.66rem; color: var(--muted); }

  /* page-load choreography */
  .l1, .l4, .l5, .l6, .l7 { animation: rise 1s var(--ease) both; }
  .l2, .l3 { animation: slide-up 1.1s var(--ease) both; }
  .l1 { animation-delay: 0.05s; }
  .l2 { animation-delay: 0.12s; }
  .l3 { animation-delay: 0.22s; }
  .l4 { animation-delay: 0.38s; }
  .l5 { animation-delay: 0.48s; }
  .l6 { animation-delay: 0.58s; }
  .l7 { animation-delay: 0.7s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes slide-up {
    from { transform: translateY(105%); }
    to { transform: none; }
  }

  @media (max-width: 900px) {
    .hero-main { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .hero-figure { justify-self: start; max-width: 320px; }
    .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spec-cell:nth-child(3) { border-left: 0; padding-left: 0; }
    .spec-cell:nth-child(n+3) { border-top: 1px solid var(--rule); }
    .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.75rem; }
  }

  @media (max-width: 520px) {
    .hero-figure { max-width: 220px; }
    .spec { grid-template-columns: minmax(0, 1fr); }
    .spec-cell { border-left: 0; padding-left: 0; }
    .spec-cell + .spec-cell { border-top: 1px solid var(--rule); }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
