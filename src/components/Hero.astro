---
import { t, ids, type Lang } from '../i18n/translations';
import { cvPdf } from '../data/site';
import Terminal from './Terminal.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
---

<section class="hero" aria-labelledby="hero-name">
  <canvas class="net" id="net" aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-status mono l1">
        <span class="pulse" aria-hidden="true"></span>
        {i.hero.status}
      </p>

      <p class="hero-cmd mono l1"><span class="accent">$</span> whoami</p>

      <h1 class="hero-name" id="hero-name">
        <span class="nm l2" data-hero-scramble>Antonio Payá</span>
        <span class="nm nm-2 l3" data-hero-scramble>González</span>
      </h1>

      <p class="hero-role mono l4">
        <span class="sr-only">{i.ui.roles.join(' · ')}</span>
        <span class="accent" aria-hidden="true">&gt;</span>
        <span id="role-text" aria-hidden="true" data-roles={JSON.stringify(i.ui.roles)}>{i.ui.roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>

      <p class="hero-statement l5" set:html={i.hero.statement} />

      <div class="hero-ctas l6">
        <a href={`#${id.contact}`} class="btn btn-primary" data-magnetic>
          {i.hero.ctaPrimary}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}${cvPdf(lang)}`} class="btn btn-ghost" download data-magnetic>
          {i.hero.ctaCv}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 12l6 6 6-6M5 21h14"/></svg>
        </a>
        <button type="button" class="btn btn-ghost hero-k" data-palette-open>
          <span class="kbd" data-kbd>Ctrl K</span>
        </button>
      </div>
    </div>

    <div class="hero-side l5">
      <div class="avatar card">
        <div class="avatar-img">
          <img src={`${base}images/foto1.webp`} alt="Antonio Payá González" width="686" height="911" fetchpriority="high" decoding="async" />
        </div>
        <div class="avatar-meta mono">
          <span class="pulse" aria-hidden="true"></span>
          <span>Gijón, ES</span>
        </div>
      </div>
      <Terminal lang={lang} />
    </div>
  </div>

  <div class="wrap">
    <ul class="metrics" aria-label="Key figures">
      {i.hero.metrics.map((m, idx) => (
        <li class="metric card reveal" style={`--d: ${idx * 0.07}s`}>
          <span class="metric-v" data-count={m.value}>{m.value}</span>
          <span class="metric-l mono">{m.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="marquee mono" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {i.ui.marquee.map((w) => <span>{w}<i>✦</i></span>)}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(68px + clamp(2.5rem, 6vw, 5rem));
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 20% 35%, color-mix(in srgb, var(--bg) 85%, transparent), transparent 70%),
      linear-gradient(180deg, transparent 60%, var(--bg));
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.72rem;
    color: var(--text-2);
    margin-bottom: 2rem;
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #28C840;
    flex-shrink: 0;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #28C840;
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.7; }
    80%, 100% { transform: scale(2.8); opacity: 0; }
  }

  .hero-cmd { font-size: 0.9rem; color: var(--muted); margin-bottom: 0.6rem; }

  .hero-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3.2rem, 7.2vw, 6.6rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-bottom: 1.4rem;
  }

  .nm { display: block; white-space: nowrap; }

  .nm-2 {
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  .hero-role {
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    color: var(--text);
    min-height: 1.8em;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-statement {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--text-2);
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .hero-statement :global(em) {
    font-style: normal;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.92em;
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .hero-k { padding-left: 0.9rem; padding-right: 0.9rem; }
  .hero-k .kbd { border: 0; padding: 0; font-size: 0.8rem; color: var(--muted); }

  /* side: avatar + terminal */
  .hero-side { position: relative; padding-top: 14rem; }

  .avatar {
    position: absolute;
    top: 0;
    right: 3rem;
    z-index: 2;
    width: 236px;
    padding: 7px;
    border-radius: 18px;
    transform: rotate(3deg);
    box-shadow: var(--shadow);
    transition: transform 0.5s var(--ease);
  }

  .avatar:hover { transform: rotate(0deg) scale(1.04); }

  .avatar-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
  }

  /* zoom on the face: it sits at ~36% / 61% of the original photo */
  .avatar-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 36% 61%;
    transform: translate(13%, -14%) scale(1.45);
    transform-origin: 36% 63%;
    filter: grayscale(0.25) contrast(1.05);
    transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
  }

  .avatar:hover .avatar-img img { transform: translate(9%, -10%) scale(1.3); filter: none; }

  .avatar-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.35rem 0.2rem;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .avatar-meta .pulse { width: 6px; height: 6px; }

  /* metrics */
  .metrics {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem 1.2rem;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(8px);
  }

  .metric-v {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.2rem, 3.6vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .metric-l { font-size: 0.7rem; color: var(--muted); }

  /* marquee */
  .marquee {
    position: relative;
    z-index: 1;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
    padding: 1.1rem 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }

  .marquee-group { display: flex; flex-shrink: 0; }

  .marquee-group span {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .marquee-group i { color: var(--accent); font-style: normal; font-size: 0.7rem; }

  @keyframes marquee { to { transform: translateX(-50%); } }

  /* load choreography */
  .l1, .l4, .l5, .l6 { animation: rise 0.9s var(--ease) both; }
  .l2, .l3 { animation: rise 0.9s var(--ease) both; }
  .l1 { animation-delay: 0.05s; }
  .l2 { animation-delay: 0.15s; }
  .l3 { animation-delay: 0.25s; }
  .l4 { animation-delay: 0.45s; }
  .l5 { animation-delay: 0.55s; }
  .l6 { animation-delay: 0.65s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); }
    .hero-side { max-width: 640px; }
    .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metric:last-child { grid-column: 1 / -1; }
    .avatar { width: 170px; right: 0.5rem; }
    .hero-side { padding-top: 11rem; }
    .hero-k { display: none; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // name decrypt on load
  document.querySelectorAll<HTMLElement>('[data-hero-scramble]').forEach((el, idx) => {
    setTimeout(() => (window as any).__scramble?.(el, 1100), 150 + idx * 180);
  });

  // rotating roles (typewriter)
  const roleEl = document.getElementById('role-text');
  const roles: string[] = roleEl?.dataset.roles ? JSON.parse(roleEl.dataset.roles) : [];
  if (roleEl && roles.length > 1 && !reduced) {
    let r = 0;
    const sleep = (ms: number) => new Promise((res) => setTimeout(res, ms));
    (async () => {
      await sleep(2600);
      for (;;) {
        const cur = roles[r];
        for (let k = cur.length; k >= 0; k--) { roleEl.textContent = cur.slice(0, k); await sleep(28); }
        r = (r + 1) % roles.length;
        const next = roles[r];
        await sleep(250);
        for (let k = 1; k <= next.length; k++) { roleEl.textContent = next.slice(0, k); await sleep(55); }
        await sleep(2400);
      }
    })();
  }

  // network canvas: zero-trust style topology with travelling packets
  const canvas = document.getElementById('net') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let W = 0, H = 0, dpr = 1;
    type Node = { x: number; y: number; vx: number; vy: number; r: number; gw: boolean };
    type Packet = { a: Node; b: Node; t: number; speed: number; color: string };
    let nodes: Node[] = [];
    let packets: Packet[] = [];
    let colors = { a: '#B6FF3B', b: '#5CE1E6', line: 'rgba(232,237,242,0.08)', node: 'rgba(232,237,242,0.35)' };
    const mouse = { x: -9999, y: -9999 };
    const LINK = 150;

    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      const light = document.documentElement.getAttribute('data-theme') === 'light';
      colors = {
        a: cs.getPropertyValue('--accent').trim() || colors.a,
        b: cs.getPropertyValue('--accent-2').trim() || colors.b,
        line: light ? 'rgba(11,15,20,0.1)' : 'rgba(232,237,242,0.11)',
        node: light ? 'rgba(11,15,20,0.35)' : 'rgba(232,237,242,0.32)',
      };
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(95, Math.round((W * H) / 15000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: Math.random() * 1.4 + 0.8,
        gw: Math.random() < 0.08,
      }));
      packets = [];
    };

    const spawnPacket = () => {
      const a = nodes[(Math.random() * nodes.length) | 0];
      let best: Node | null = null, bd = Infinity;
      for (const n of nodes) {
        if (n === a) continue;
        const d = (n.x - a.x) ** 2 + (n.y - a.y) ** 2;
        if (d < LINK * LINK && d < bd && Math.random() > 0.3) { best = n; bd = d; }
      }
      if (best) packets.push({ a, b: best, t: 0, speed: 0.006 + Math.random() * 0.01, color: Math.random() < 0.7 ? colors.a : colors.b });
    };

    let running = true;
    let last = 0;
    const draw = (now = 0) => {
      if (!running) return;
      const dt = Math.min((now - last) / 16.67, 3) || 1;
      last = now;
      ctx.clearRect(0, 0, W, H);

      for (const n of nodes) {
        n.x += n.vx * dt; n.y += n.vy * dt;
        if (n.x < -20) n.x = W + 20; if (n.x > W + 20) n.x = -20;
        if (n.y < -20) n.y = H + 20; if (n.y > H + 20) n.y = -20;
        const dx = n.x - mouse.x, dy = n.y - mouse.y, d2 = dx * dx + dy * dy;
        if (d2 < 120 * 120 && d2 > 1) { const f = 0.6 / Math.sqrt(d2); n.x += dx * f; n.y += dy * f; }
      }

      ctx.lineWidth = 1;
      for (let a = 0; a < nodes.length; a++) {
        const na = nodes[a];
        for (let b = a + 1; b < nodes.length; b++) {
          const nb = nodes[b];
          const dx = na.x - nb.x, dy = na.y - nb.y, d2 = dx * dx + dy * dy;
          if (d2 < LINK * LINK) {
            ctx.globalAlpha = 1 - Math.sqrt(d2) / LINK;
            ctx.strokeStyle = colors.line;
            ctx.beginPath(); ctx.moveTo(na.x, na.y); ctx.lineTo(nb.x, nb.y); ctx.stroke();
          }
        }
        const mdx = na.x - mouse.x, mdy = na.y - mouse.y, md = Math.sqrt(mdx * mdx + mdy * mdy);
        if (md < 200) {
          ctx.globalAlpha = (1 - md / 200) * 0.6;
          ctx.strokeStyle = colors.a;
          ctx.beginPath(); ctx.moveTo(na.x, na.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;

      for (const n of nodes) {
        if (n.gw) {
          ctx.strokeStyle = colors.b;
          ctx.globalAlpha = 0.8;
          ctx.strokeRect(n.x - 3.5, n.y - 3.5, 7, 7);
          ctx.globalAlpha = 0.15;
          ctx.beginPath(); ctx.arc(n.x, n.y, 12, 0, Math.PI * 2); ctx.stroke();
          ctx.globalAlpha = 1;
        } else {
          ctx.fillStyle = colors.node;
          ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx.fill();
        }
      }

      if (Math.random() < 0.12 * dt && packets.length < 40) spawnPacket();
      packets = packets.filter((p) => p.t <= 1);
      for (const p of packets) {
        p.t += p.speed * dt;
        const x = p.a.x + (p.b.x - p.a.x) * p.t;
        const y = p.a.y + (p.b.y - p.a.y) * p.t;
        const tx = p.a.x + (p.b.x - p.a.x) * Math.max(0, p.t - 0.18);
        const ty = p.a.y + (p.b.y - p.a.y) * Math.max(0, p.t - 0.18);
        const g = ctx.createLinearGradient(tx, ty, x, y);
        g.addColorStop(0, 'transparent');
        g.addColorStop(1, p.color);
        ctx.strokeStyle = g;
        ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(x, y); ctx.stroke();
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 8;
        ctx.beginPath(); ctx.arc(x, y, 1.8, 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
      }

      requestAnimationFrame(draw);
    };

    readColors();
    resize();
    window.addEventListener('resize', () => { resize(); if (reduced) draw(); });
    window.addEventListener('themechange', readColors);

    const hero = canvas.parentElement!;
    hero.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    }, { passive: true });
    hero.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });

    if (reduced) {
      running = true; draw(); running = false;
    } else {
      let inView = true;
      const sync = () => {
        const shouldRun = inView && !document.hidden;
        if (shouldRun && !running) { running = true; last = performance.now(); requestAnimationFrame(draw); }
        else if (!shouldRun) running = false;
      };
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; sync(); }).observe(canvas);
      document.addEventListener('visibilitychange', sync);
      requestAnimationFrame(draw);
    }
  }
</script>
