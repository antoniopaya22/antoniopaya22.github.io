---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.awards;
---

<section class="section" id={id.awards}>
  <div class="wrap section-grid">
    <SectionHead n={s.n} title={s.title} desc={s.desc} />

    <ol class="section-body awards">
      {i.awards.items.map((a) => (
        <li class="award reveal">
          <span class="mono award-year">{a.year}</span>
          <h3 class="award-title">{a.title}</h3>
          <span class="award-org">{a.org}</span>
          <p class="award-desc">{a.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .awards { list-style: none; border-top: 1px solid var(--ink); }

  .award {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-areas:
      'year title org'
      'year desc desc';
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.3s var(--ease);
  }

  .award-year { grid-area: year; font-size: 0.75rem; color: var(--accent); padding-top: 0.35rem; }

  .award-title {
    grid-area: title;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .award-org { grid-area: org; color: var(--ink-2); font-weight: 500; padding-top: 0.25rem; text-align: right; }
  .award-desc { grid-area: desc; color: var(--muted); font-size: 0.95rem; }

  @media (max-width: 640px) {
    .award {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      grid-template-areas:
        'year title'
        'year org'
        'year desc';
    }
    .award-org { text-align: left; padding-top: 0; font-size: 0.92rem; }
  }
</style>
