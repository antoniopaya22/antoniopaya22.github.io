---
interface Props {
  n: string;
  title: string;
  desc?: string;
  file: string;
}
const { n, title, desc, file } = Astro.props;
---

<header class="sh">
  <div class="sh-meta mono reveal">
    <span class="sh-n">// {n}</span>
    <span class="sh-file">{file}</span>
    <span class="sh-line" aria-hidden="true"></span>
  </div>
  <div class="sh-row">
    <h2 class="sh-title" data-scramble>{title}</h2>
    {desc && <p class="sh-desc reveal" style="--d: 0.1s">{desc}</p>}
  </div>
</header>

<style>
  .sh { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  .sh-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.78rem;
    margin-bottom: 1rem;
  }

  .sh-n { color: var(--accent); }

  .sh-file {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
  }

  .sh-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--line-strong), transparent); }

  .sh-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
  }

  .sh-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    min-height: 0.95em;
  }

  .sh-desc {
    color: var(--muted);
    max-width: 38ch;
    font-size: 1rem;
  }
</style>
