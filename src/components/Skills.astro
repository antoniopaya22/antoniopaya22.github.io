---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.skills;

const files = ['cloud.yaml', 'architecture.md', 'security.ts', 'ai_ml.py', 'backend.go', 'frontend.tsx', 'data.sql', 'chain.sol'];
const langColor: Record<string, string> = { yaml: '#CB171E', md: '#7D8794', ts: '#3178C6', py: '#FFD43B', go: '#00ADD8', tsx: '#61DAFB', sql: '#E38C00', sol: '#9CA3AF' };

const q = (v: string) => `<span class="s">"${v}"</span>`;
const sq = (v: string) => `<span class="s">'${v}'</span>`;

// one code listing per group, each "written" in the language of its file extension
const render = (ext: string, label: string, items: readonly string[]): string[] => {
  const name = label.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z]+/g, '_').replace(/^_|_$/g, '');
  switch (ext) {
    case 'yaml':
      return [`<span class="c"># ${label}</span>`, `<span class="p">${name}</span>:`, ...items.map((x) => `  - ${q(x)}`)];
    case 'md':
      return [`<span class="k"># ${label}</span>`, '', ...items.map((x) => `<span class="n">-</span> ${x}`)];
    case 'ts':
      return [`<span class="c">// ${label}</span>`, `<span class="k">export const</span> ${name} <span class="k">=</span> [`, ...items.map((x) => `  ${sq(x)},`), `] <span class="k">as const</span>;`];
    case 'py':
      return [`<span class="c"># ${label}</span>`, `${name} <span class="k">=</span> [`, ...items.map((x) => `    ${q(x)},`), ']'];
    case 'go':
      return [`<span class="k">package</span> stack`, '', `<span class="c">// ${label}</span>`, `<span class="k">var</span> ${name} <span class="k">=</span> []<span class="p">string</span>{`, ...items.map((x) => `\t${q(x)},`), '}'];
    case 'tsx':
      return [`<span class="c">{/* ${label} */}</span>`, `<span class="k">export const</span> <span class="p">Stack</span> <span class="k">=</span> () <span class="k">=></span> (`, '  &lt;<span class="p">ul</span>&gt;', ...items.map((x) => `    &lt;<span class="p">li</span>&gt;${x}&lt;/<span class="p">li</span>&gt;`), '  &lt;/<span class="p">ul</span>&gt;', ');'];
    case 'sql':
      return [`<span class="c">-- ${label}</span>`, `<span class="k">INSERT INTO</span> stack (name) <span class="k">VALUES</span>`, ...items.map((x, k) => `  (${sq(x)})${k === items.length - 1 ? ';' : ','}`)];
    case 'sol':
      return [`<span class="c">// ${label}</span>`, `<span class="k">pragma solidity</span> <span class="n">^0.8.0</span>;`, '', `<span class="k">contract</span> <span class="p">Stack</span> {`, `  <span class="k">string[] public</span> items <span class="k">=</span> [`, ...items.map((x) => `    ${q(x)},`), '  ];', '}'];
    default:
      return [...items];
  }
};

const tabs = i.skills.groups.map((g, k) => {
  const file = files[k] ?? `group${k}.txt`;
  const ext = file.split('.').pop()!;
  return { file, ext, label: g.label, items: g.items, lines: render(ext, g.label, g.items) };
});
---

<section class="section" id={id.skills}>
  <div class="wrap">
    <SectionHead n={s.n} file={s.file} title={s.title} desc={s.desc} />

    <div class="ide win reveal">
      <div class="win-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="ide-title">~/antonio-paya/stack — {lang === 'es' ? 'editor' : 'editor'}</span>
      </div>

      <div class="ide-body">
        <aside class="explorer mono">
          <p class="ex-head">EXPLORER</p>
          <p class="ex-folder"><span aria-hidden="true">▾</span> stack</p>
          <div role="tablist" aria-orientation="vertical" aria-label={s.title} class="ex-files">
            {tabs.map((tab, k) => (
              <button
                type="button"
                role="tab"
                class="ex-file"
                id={`tab-${tab.ext}`}
                aria-selected={k === 0 ? 'true' : 'false'}
                aria-controls={`panel-${tab.ext}`}
                tabindex={k === 0 ? 0 : -1}
              >
                <span class="ex-dot" style={`background:${langColor[tab.ext]}`} aria-hidden="true"></span>
                {tab.file}
              </button>
            ))}
          </div>
        </aside>

        <div class="editor">
          {tabs.map((tab, k) => (
            <div class="panel" role="tabpanel" id={`panel-${tab.ext}`} aria-labelledby={`tab-${tab.ext}`} hidden={k !== 0}>
              <div class="ed-tabs mono">
                <span class="ed-tab"><span class="ex-dot" style={`background:${langColor[tab.ext]}`} aria-hidden="true"></span>{tab.file}</span>
                <span class="ed-count">{tab.items.length} items</span>
              </div>
              <pre class="ed-code mono"><code>{tab.lines.map((line, n) => (
                <span class="ed-line" style={`--l: ${n}`}><span class="ln">{n + 1}</span><span set:html={line || ' '} /></span>
              ))}</code></pre>
              <ul class="sr-only">{tab.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ide-title { flex: 1; text-align: center; }

  .ide-body { display: grid; grid-template-columns: 230px minmax(0, 1fr); min-height: 440px; }

  .explorer {
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
    padding: 0.9rem 0.5rem;
    font-size: 0.8rem;
  }

  .ex-head { font-size: 0.64rem; letter-spacing: 0.1em; color: var(--muted); padding: 0 0.6rem 0.7rem; }
  .ex-folder { padding: 0.3rem 0.6rem; color: var(--text-2); }
  .ex-files { display: flex; flex-direction: column; }

  .ex-file {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.38rem 0.6rem 0.38rem 1.6rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font-family: var(--mono);
    font-size: 0.8rem;
    text-align: left;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .ex-file:hover { color: var(--text); background: var(--surface-2); }
  .ex-file[aria-selected='true'] { color: var(--text); background: var(--accent-glow); box-shadow: inset 2px 0 0 var(--accent); }

  .ex-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }

  .editor { min-width: 0; display: flex; }
  .panel { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .panel[hidden] { display: none; }

  .ed-tabs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    padding-right: 1rem;
  }

  .ed-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-right: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    background: var(--surface);
    color: var(--text);
  }

  .ed-count { color: var(--muted); font-size: 0.68rem; }

  .ed-code {
    flex: 1;
    padding: 1rem 1rem 1.25rem 0.4rem;
    font-size: 0.86rem;
    line-height: 1.9;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .ed-line { display: block; white-space: pre; }

  .panel:not([hidden]) .ed-line { animation: line-in 0.45s var(--ease) both; animation-delay: calc(var(--l) * 35ms); }

  @keyframes line-in {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: none; }
  }

  .ln {
    display: inline-block;
    width: 2.6rem;
    padding-right: 1rem;
    text-align: right;
    color: var(--syn-com);
    opacity: 0.55;
    user-select: none;
  }

  @media (max-width: 760px) {
    .ide-body { grid-template-columns: minmax(0, 1fr); }
    .explorer { border-right: 0; border-bottom: 1px solid var(--line); padding: 0.6rem; overflow-x: auto; }
    .ex-head, .ex-folder { display: none; }
    .ex-files { flex-direction: row; gap: 0.25rem; }
    .ex-file { padding: 0.4rem 0.6rem; white-space: nowrap; }
    .ed-code { font-size: 0.76rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ide').forEach((ide) => {
    const tabs = Array.from(ide.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, k) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (dir) { e.preventDefault(); select(tabs[(k + dir + tabs.length) % tabs.length], true); }
      });
    });
  });
</script>
