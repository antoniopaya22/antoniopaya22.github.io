---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.skills;
---

<section class="section" id={id.skills}>
  <div class="wrap section-grid">
    <SectionHead n={s.n} title={s.title} desc={s.desc} />

    <div class="section-body skills">
      {i.skills.groups.map((g, idx) => (
        <div class="group reveal" style={`--d: ${(idx % 2) * 0.06}s`}>
          <h3 class="group-label">
            <span class="mono group-n">{String(idx + 1).padStart(2, '0')}</span>
            {g.label}
          </h3>
          <ul class="group-items">
            {g.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }

  .group {
    padding: 1.5rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .group:nth-child(even) { padding-left: 1.5rem; padding-right: 0; border-left: 1px solid var(--rule); }

  .group-label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.1;
    margin-bottom: 0.85rem;
  }

  .group-n { font-size: 0.62rem; color: var(--accent); }

  .group-items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .group-items li {
    font-size: 0.88rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
    transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }

  .group-items li:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  @media (max-width: 720px) {
    .skills { grid-template-columns: minmax(0, 1fr); }
    .group:nth-child(even) { padding-left: 0; border-left: 0; }
  }
</style>
