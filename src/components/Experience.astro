---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const i = t(lang);
const id = ids(lang);
const s = i.sections.experience;
---

<section class="section" id={id.experience}>
  <div class="wrap section-grid">
    <SectionHead n={s.n} title={s.title} desc={s.desc} />

    <ol class="section-body jobs">
      {i.experience.jobs.map((job) => (
        <li class:list={['job reveal', { current: job.current }]}>
          <div class="job-when">
            <span class="mono job-period">{job.period}</span>
            {job.current && <span class="mono job-now"><span class="now-dot" aria-hidden="true"></span>{i.experience.current}</span>}
          </div>

          <div class="job-main">
            <div class="job-head">
              <div class:list={['job-logo', { 'on-dark': job.logoOnDark }]}>
                <img src={`${base}images/${job.logo}`} alt="" width="72" height="48" loading="lazy" decoding="async" />
              </div>
              <div>
                <h3 class="job-role">{job.role}</h3>
                <p class="job-company">{job.company} <span class="job-type">· {job.type}</span></p>
              </div>
            </div>

            <ul class="job-points">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>

            <div class="job-tags">
              {job.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jobs { list-style: none; border-top: 1px solid var(--ink); }

  .job {
    position: relative;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .job::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 0;
    background: var(--accent);
    transition: width 0.6s var(--ease);
  }

  .job:hover::before { width: 100%; }

  .job-when { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.3rem; }

  .job-period { font-size: 0.7rem; color: var(--muted); letter-spacing: 0.04em; }

  .job-now {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.66rem;
    color: var(--accent);
  }

  .now-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .job-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }

  .job-logo {
    width: 72px;
    height: 48px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    padding: 7px 9px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .job-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 0.4s var(--ease);
  }

  .job:hover .job-logo img { filter: none; }

  .job-logo.on-dark { background: #141410; border-color: #141410; }

  .job-role {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    line-height: 1.05;
  }

  .job-company { font-size: 0.95rem; font-weight: 500; color: var(--ink-2); margin-top: 0.2rem; }
  .job-type { color: var(--muted); font-weight: 400; }

  .job-points {
    list-style: none;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
    max-width: 62ch;
  }

  .job-points li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.3rem;
  }

  .job-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }

  .job-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  @media (max-width: 640px) {
    .job { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
    .job-when { flex-direction: row; align-items: center; gap: 1rem; padding-top: 0; }
  }
</style>
