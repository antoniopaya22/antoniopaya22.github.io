---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.about;
---

<section class="section" id={id.about}>
  <div class="wrap section-grid">
    <SectionHead n={s.n} title={s.title} desc={s.desc}>
      <dl class="facts reveal" style="--d: 0.15s">
        {i.about.facts.map((f) => (
          <div>
            <dt class="mono">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </SectionHead>

    <div class="section-body">
      <p class="lead prose reveal" set:html={i.about.lead} />
      <div class="body prose">
        {i.about.body.map((p, idx) => <p class="reveal" style={`--d: ${0.05 * idx}s`} set:html={p} />)}
      </div>

      <h3 class="focus-title mono reveal">{i.about.focusTitle}</h3>
      <ol class="focus">
        {i.about.focus.map((f, idx) => (
          <li class="focus-item reveal" style={`--d: ${idx * 0.06}s`}>
            <span class="focus-n mono">{String(idx + 1).padStart(2, '0')}</span>
            <h4 class="focus-h">{f.title}</h4>
            <p class="focus-d">{f.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .facts {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
  }

  .facts dt { font-size: 0.66rem; color: var(--muted); margin-bottom: 0.15rem; }
  .facts dd { font-size: 0.95rem; color: var(--ink-2); }

  .lead {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }

  .lead :global(strong) {
    font-weight: 400;
    font-style: italic;
    color: var(--accent);
  }

  .body {
    columns: 2;
    column-gap: 2.5rem;
    color: var(--ink-2);
  }

  .body p { break-inside: avoid; margin-bottom: 1.1rem; }

  .focus-title {
    color: var(--muted);
    font-size: 0.7rem;
    margin: 3rem 0 0;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
  }

  .focus {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .focus-item {
    padding: 1.4rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .focus-item:nth-child(even) { padding-left: 1.5rem; border-left: 1px solid var(--rule); }

  .focus-n { font-size: 0.66rem; color: var(--accent); }

  .focus-h {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.1;
    margin: 0.35rem 0 0.4rem;
  }

  .focus-d { color: var(--muted); font-size: 0.95rem; }

  @media (max-width: 720px) {
    .body { columns: 1; }
    .focus { grid-template-columns: minmax(0, 1fr); }
    .focus-item:nth-child(even) { padding-left: 0; border-left: 0; }
  }
</style>
