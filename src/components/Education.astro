---
import { t, ids, type Lang } from '../i18n/translations';
import SectionHead from './SectionHead.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const i = t(lang);
const id = ids(lang);
const s = i.sections.education;
const levels = ['PhD', 'MSc', 'BSc'];
---

<section class="section" id={id.education}>
  <div class="wrap">
    <SectionHead n={s.n} file={s.file} title={s.title} desc={s.desc} />

    <ol class="degrees">
      {i.education.degrees.map((d, idx) => (
        <li class="degree card reveal" style={`--d: ${idx * 0.08}s`}>
          <div class="d-top mono">
            <span class="d-level">{levels[idx]}</span>
            <span class="d-period">{d.period}</span>
          </div>
          <h3 class="d-title">{d.title}</h3>
          <p class="d-school">{d.school}</p>
          <p class="d-desc">{d.desc}</p>
          {d.honors.length > 0 && (
            d.honors.length > 2 ? (
              <details class="honors">
                <summary class="mono">★ {d.honors.length} {i.education.honorsLabel}</summary>
                <ul>{d.honors.map((h) => <li>{h}</li>)}</ul>
              </details>
            ) : (
              <p class="honors-inline mono">★ {i.education.honorsLabel}: {d.honors.join(', ')}</p>
            )
          )}
        </li>
      ))}
    </ol>

    <h3 class="list-title mono reveal"><span class="accent">#</span> {i.education.certsTitle}</h3>
    <ul class="certs">
      {i.education.certs.map((c, idx) => (
        <li class="cert reveal" style={`--d: ${(idx % 3) * 0.05}s`}>
          <span class="cert-check mono" aria-hidden="true">✓</span>
          <span class="cert-title">{c.title}</span>
          <span class="cert-issuer mono">{c.issuer}</span>
          <span class="cert-year mono">{c.year}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .degrees {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 4rem);
    align-items: start;
  }

  .degree { padding: 1.4rem 1.4rem 1.5rem; }

  .d-top { display: flex; justify-content: space-between; align-items: center; font-size: 0.72rem; margin-bottom: 1.1rem; }

  .d-level {
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    background: var(--accent-glow);
    color: var(--accent);
    font-weight: 700;
  }

  .d-period { color: var(--muted); }

  .d-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .d-school { color: var(--accent-2); font-size: 0.9rem; margin: 0.25rem 0 0.7rem; }
  .d-desc { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }

  .honors-inline { margin-top: 0.9rem; font-size: 0.72rem; color: var(--syn-num); }

  .honors { margin-top: 0.9rem; }

  .honors summary {
    cursor: pointer;
    font-size: 0.72rem;
    color: var(--syn-num);
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .honors summary::-webkit-details-marker { display: none; }
  .honors summary::after { content: '▸'; transition: transform 0.25s var(--ease); }
  .honors[open] summary::after { transform: rotate(90deg); }

  .honors ul { list-style: none; margin-top: 0.7rem; font-size: 0.85rem; color: var(--text-2); display: grid; gap: 0.2rem; }
  .honors li::before { content: '› '; color: var(--syn-num); font-family: var(--mono); }

  .list-title { font-size: 0.85rem; color: var(--text-2); font-weight: 500; margin-bottom: 1rem; }

  .certs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    border-top: 1px solid var(--line);
  }

  .cert {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) auto 3rem;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .cert-check { color: #28C840; font-size: 0.8rem; }
  .cert-title { font-weight: 500; font-size: 0.95rem; }
  .cert-issuer { font-size: 0.72rem; color: var(--muted); }
  .cert-year { font-size: 0.72rem; color: var(--syn-num); text-align: right; }

  @media (max-width: 960px) {
    .degrees { grid-template-columns: minmax(0, 1fr); }
    .certs { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 520px) {
    .cert { grid-template-columns: 1.4rem minmax(0, 1fr) 3rem; }
    .cert-issuer { grid-column: 2; grid-row: 2; }
    .cert-year { grid-row: 1; grid-column: 3; }
  }
</style>
