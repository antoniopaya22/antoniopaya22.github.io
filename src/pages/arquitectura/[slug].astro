---
import ArchCase from '../../components/ArchCase.astro';
import { archSlug, getCases, type ArchCase as Case } from '../../data/architecture';

export async function getStaticPaths() {
  const cases = await getCases('es');
  return cases.map((item) => ({ params: { slug: archSlug(item) }, props: { item } }));
}

interface Props { item: Case; }
const { item } = Astro.props;
---

<ArchCase lang="es" item={item} />
